{
  "schema": "swankit-wondergate-title/1",
  "id": "sennou-millennium-japan",
  "provenance": {
    "server": "new",
    "notes": "Clean-room request and response grammar from the private wave-2 ROM probes. Empty histories, best-per-identity ordering, dates, score conversion and structural blank slots are newly authored revival policy; no original server data or assets."
  },
  "hosts": [
    "wgg01.channel.or.jp"
  ],
  "boards": {
    "course-1": {
      "identity": "*",
      "order": "desc",
      "ties": "first-best-submission",
      "course": "1"
    }
  },
  "records": {
    "row": [
      {
        "text": " "
      },
      {
        "field": "rank",
        "fmt": "dec"
      },
      {
        "text": "|"
      },
      {
        "field": "score",
        "fmt": "dec"
      },
      {
        "text": "|"
      },
      {
        "field": "name",
        "fmt": "raw"
      },
      {
        "text": "|"
      },
      {
        "field": "extra",
        "fmt": "dec"
      },
      {
        "text": "\r\n"
      }
    ]
  },
  "routes": [
    {
      "id": "ranking",
      "method": "POST",
      "match": {
        "path": "/service/swan-ranking/sen-know"
      },
      "source": "form",
      "request": {
        "*": {
          "decode": "percent-plus",
          "bytes": [
            6,
            6
          ],
          "alphabet": "0123456789ABCDEF"
        },
        "owner": {
          "decode": "percent-plus",
          "bytes": [
            0,
            16
          ],
          "min_byte": 32,
          "deny": [
            124,
            127
          ],
          "trim_end": 32
        },
        "list": {
          "decode": "percent-plus",
          "equals": [
            114,
            97,
            110,
            107,
            105,
            110,
            103,
            124,
            49,
            48,
            124,
            43,
            49,
            54
          ]
        }
      },
      "tables": {
        "score": {
          "delimiter": 124,
          "optional": false,
          "rows": {
            "1": [
              {
                "as": "u64",
                "regex": "^[0-9]{1,8}$"
              },
              {
                "as": "u64",
                "regex": "^[0-9]{1,3}$",
                "max_number": 127
              }
            ]
          }
        }
      },
      "table_actions": [
        {
          "field": "score",
          "identity": "*",
          "name": "owner",
          "score": 0,
          "boards": {
            "1": "course-1"
          },
          "extra": 1
        }
      ],
      "respond": {
        "status": 200,
        "content_type": "application/x-swan-ranking-response",
        "body": [
          {
            "text": "date="
          },
          {
            "date": 14
          },
          {
            "text": "\r\ncourse=1|1|"
          },
          {
            "board": "course-1",
            "metric": "count",
            "fmt": "dec"
          },
          {
            "text": "|0|0|"
          },
          {
            "board": "course-1",
            "metric": "position",
            "fmt": "dec",
            "identity": "*"
          },
          {
            "text": "\r\nranking="
          },
          {
            "board": "course-1",
            "metric": "length",
            "fmt": "dec",
            "limit": 16,
            "pad_to": 0
          },
          {
            "text": "\r\n"
          },
          {
            "each": {
              "leaders": {
                "board": "course-1",
                "limit": 16,
                "pad_to": 0
              }
            },
            "record": "row"
          }
        ]
      }
    }
  ],
  "limits": {
    "max_body": 65536,
    "max_response": 1023
  },
  "errors": {
    "method": 405,
    "method_first": false
  }
}
