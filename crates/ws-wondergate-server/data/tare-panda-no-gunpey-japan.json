  "routes": [
    {
      "id": "ranking",
      "method": "POST",
      "match": {
        "path": "/service/swan-ranking/tarepang"
      },
      "source": "form",
      "request": {
        "*": {
          "decode": "percent-plus",
          "bytes": [
            6,
            6
          ],
          "alphabet": "0123456789ABCDEF"
        },
        "owner": {
          "decode": "percent-plus",
          "bytes": [
            0,
            16
          ],
          "min_byte": 32,
          "deny": [
            124,
            127
          ],
          "trim_end": 32
        },
        "list": {
          "decode": "percent-plus",
          "equals": [
            84,
            65,
            82,
            69,
            124,
            49,
            124,
            51
          ]
        },
        "group": {
          "decode": "percent-plus",
          "default": [
            49
          ],
          "equals": [
            49
          ]
        }
      },
      "tables": {
        "score": {
          "delimiter": 124,
          "optional": true,
          "rows": {
            "1": [
              {
                "as": "u64",
                "regex": "^[0-9]{10,10}$"
              },
              {
                "as": "u64",
                "regex": "^[0-9]{1,4}$",
                "max_number": 9999
              }
            ],
            "2": [
              {
                "as": "u64",
