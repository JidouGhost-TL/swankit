from typing import Any, Sequence, TYPE_CHECKING

if TYPE_CHECKING:
    from PIL.Image import Image as PillowImage

class SwankitError(ValueError): ...
class ResourceLimitError(SwankitError): ...
class UnsupportedError(SwankitError): ...

class RomFacts:
    @property
    def size_bytes(self) -> int: ...
    @property
    def checksum_ok(self) -> bool: ...
    @property
    def color(self) -> bool: ...
    @property
    def game_id(self) -> int: ...
    @property
    def publisher_id(self) -> int: ...
    @property
    def declared_rom_bytes(self) -> int | None: ...
    @property
    def save_bytes(self) -> int | None: ...
    def to_dict(self) -> dict[str, Any]: ...

class Detection:
    @property
    def selected(self) -> str | None: ...
    @property
    def confidence(self) -> str | None: ...
    @property
    def candidates(self) -> list[str]: ...
    def to_dict(self) -> dict[str, Any]: ...

class DecodeResult:
    @property
    def data(self) -> bytes: ...
    @property
    def consumed(self) -> int: ...

class Image:
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def rgba(self) -> bytes: ...

class TextResult:
    @property
    def text(self) -> str: ...
    @property
    def normalized(self) -> str: ...
    @property
    def consumed(self) -> int: ...
    @property
    def terminated(self) -> bool: ...
    @property
    def final_page(self) -> int: ...
    def to_dict(self) -> dict[str, Any]: ...

class TextDefinition:
    def __init__(self, definition_json: str) -> None: ...
    @staticmethod
    def builtin(id: str) -> TextDefinition: ...
    @property
    def id(self) -> str: ...
    def to_dict(self) -> dict[str, Any]: ...
    def decode(self, data: bytes) -> TextResult: ...
    def encode(self, text: str, *, max_bytes: int = 65536) -> bytes: ...
    def encode_tokens(self, decoded: TextResult) -> bytes: ...
    def dump(self, data: bytes, table: str) -> dict[str, Any]: ...
    def font(self, data: bytes, font: str, *, columns: int = 16) -> Image: ...

class Wave:
    def __init__(self, data: bytes) -> None: ...
    @property
    def samples(self) -> bytes: ...
    def to_pcm(self, sample_rate: int = 24000) -> Pcm: ...

class Pcm:
    @property
    def sample_rate(self) -> int: ...
    @property
    def channels(self) -> int: ...
    @property
    def frame_count(self) -> int: ...
    @property
    def samples(self) -> list[int]: ...
    def s16le(self) -> bytes: ...

class SaveContext:
    def __init__(self, definition_json: str | None = None) -> None: ...

class SaveDefinition:
    def __init__(self, definition_json: str) -> None: ...
    @staticmethod
    def builtin(id: str) -> SaveDefinition: ...
    @property
    def id(self) -> str: ...
    @property
    def fields(self) -> list[dict[str, Any]]: ...
    def to_dict(self) -> dict[str, Any]: ...
    def accepts_size(self, size: int) -> bool: ...
    def decode(self, data: bytes, *, name: str = "save", context: SaveContext | None = None) -> dict[str, Any]: ...
    def verify(self, data: bytes, *, name: str = "save", context: SaveContext | None = None) -> dict[str, int] | None: ...
    def set_field(self, data: bytes, field: int, value: Any, *, repair: bool = True, name: str = "save", context: SaveContext | None = None) -> bytes: ...
    def fix(self, data: bytes, *, name: str = "save", context: SaveContext | None = None) -> bytes: ...

def rom_facts(data: bytes) -> RomFacts: ...
def detect(data: bytes, extension: str | None = None, *, name: str = "save", context: SaveContext | None = None) -> Detection: ...
def decode(codec: str, data: bytes, *, max_output: int = 65536, history: bytes | None = None, decoded_size: int | None = None, bit_order: str = "lsb-first", fill: int = 0) -> DecodeResult: ...
def encode(codec: str, data: bytes, *, bit_order: str = "lsb-first", fill: int = 0) -> bytes: ...
def tiles(data: bytes, format: str = "2bpp", *, palette: bytes | None = None, columns: int = 16, scale: int = 1, tiles_wide: int = 1, tiles_high: int = 1, column_major: bool = False, max_bytes: int = 67108864) -> Image: ...
def color_palette(data: bytes, index: int = 0) -> bytes: ...
def mono_palette(ports: bytes, index: int = 0) -> bytes: ...
def grayscale(colors: int) -> bytes: ...
def to_pil(image: Image) -> PillowImage: ...
def waves(data: bytes) -> list[Wave]: ...
def unsigned_pcm(data: bytes, sample_rate: int) -> Pcm: ...
def pcm_preview(wave_bank: bytes, writes: Sequence[tuple[int, int, int]], frames: int, *, coupled: bool = False) -> Pcm: ...
def sound_extract(data: bytes, definition_json: str) -> dict[str, Any]: ...
def save_definitions() -> list[str]: ...
def ips_apply(base: bytes, patch: bytes, *, allow_growth: bool = False, allow_overlap: bool = False, max_output: int = 67108864) -> bytes: ...
def ips_create(base: bytes, target: bytes) -> bytes: ...
